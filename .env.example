# Backend (FastAPI). Every variable the API reads, and nothing else.
#
# Production: bootstrap.sh writes these to /etc/cleanair.env on the box and the
# systemd unit loads that file. Edit it there, then `sudo systemctl restart cleanair`.
# Local:      you do not need this file at all -- the defaults below are the dev ones.

# Start the in-process poller that pulls new sessions and refits.
# MUST be 1 in production. A deploy that forgets it looks healthy and never
# updates itself again. Off locally so a dev API does not start pulling.
CLEANAIR_POLL=0

# Comma-separated front-end origins allowed by CORS, scheme included, no
# trailing slash. Must match the Vercel URL exactly; add preview URLs if you
# want them working too.
# Default when unset: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=https://clean-air-murex.vercel.app
