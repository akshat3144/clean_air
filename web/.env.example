# Frontend (Vite). Copy to web/.env.local for local overrides -- but you
# usually do not need to: with nothing set, dev proxies /api to :8000.

# Where the built app calls the API. BUILD-TIME: set it in Vercel's project
# settings, not here, and redeploy to change it. Must be https, or the browser
# blocks the request as mixed content. Leave unset in dev.
VITE_API_BASE=https://trackshift-api.duckdns.org

# Dev only: where the Vite proxy forwards /api. Default http://127.0.0.1:8000.
# VITE_API_TARGET=http://127.0.0.1:8000
